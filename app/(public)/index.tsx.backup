import { LinearGradient } from 'expo-linear-gradient'
import { useRouter } from 'expo-router'
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { Button, Dimensions, FlatList, GestureResponderEvent, Image, PanResponder, PanResponderGestureState, StyleSheet, Text, TextInput, View } from 'react-native'
import BasketCard from '../../components/BasketCard'
import MapViewComponent from '../../components/MapView'
import FooterBar from '../../components/ui/FooterBar'
import { theme } from '../../constants/theme'
import { api, Basket } from '../../lib/api'

const { width, height } = Dimensions.get('window')

function generateMockBaskets(): Basket[] {
  const now = new Date()
  const plus2h = new Date(now.getTime() + 2 * 60 * 60 * 1000).toISOString()
  const plus3h = new Date(now.getTime() + 3 * 60 * 60 * 1000).toISOString()
  return [
    {
      id: 'mock-1',
      merchant_id: 'm1',
      title: 'Panier Boulangerie Mix',
      description: 'Assortiment de viennoiseries et pains du jour',
      original_price: 1200,
      sale_price: 480,
      qty_available: 3,
      pickup_start: now.toISOString(),
      pickup_end: plus2h,
      photo_url: 'https://images.unsplash.com/photo-1549931319-a545dcf3bc73?q=80&w=1200&auto=format&fit=crop',
      status: 'active',
      created_at: now.toISOString(),
      merchants: {
        name: 'Boulangerie El Amir',
        lat: 36.75,
        lng: 3.05,
        address: 'Rue Didouche Mourad',
        city: 'Alger',
      },
    },
    {
      id: 'mock-2',
      merchant_id: 'm2',
      title: 'Fruits & Légumes du Marché',
      description: 'Panier surprise de produits frais',
      original_price: 1500,
      sale_price: 600,
      qty_available: 5,
      pickup_start: now.toISOString(),
      pickup_end: plus3h,
      photo_url: 'https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=1200&auto=format&fit=crop',
      status: 'active',
      created_at: now.toISOString(),
      merchants: {
        name: "Primeur Ben Ali",
        lat: 36.76,
        lng: 3.06,
        address: 'Bd. Mohammed V',
        city: 'Alger',
      },
    },
    {
      id: 'mock-3',
      merchant_id: 'm3',
      title: 'Surprise Pâtisserie',
      description: '2 parts gâteaux + 1 tartelette',
      original_price: 1800,
      sale_price: 720,
      qty_available: 2,
      pickup_start: now.toISOString(),
      pickup_end: plus2h,
      photo_url: 'https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?q=80&w=1200&auto=format&fit=crop',
      status: 'active',
      created_at: now.toISOString(),
      merchants: {
        name: 'Pâtisserie Safir',
        lat: 36.74,
        lng: 3.04,
        address: 'Rue Hassiba Ben Bouali',
        city: 'Alger',
      },
    },
  ] as Basket[]
}

export default function PublicHome() {
  const router = useRouter()
  const [query, setQuery] = useState('')
  const [baskets, setBaskets] = useState<Basket[]>([])
  const [loading, setLoading] = useState(true)
  const [viewMode, setViewMode] = useState<'list' | 'map'>('list')
  const [region, setRegion] = useState({
    latitude: 36.7525,
    longitude: 3.04197,
    latitudeDelta: 0.09,
    longitudeDelta: 0.04,
  })

  useEffect(() => {
    (async () => {
      try {
        const data = await api.getActiveBaskets()
        if (!data || data.length === 0) {
          const mocks = generateMockBaskets()
          setBaskets(mocks)
          const first = mocks[0]
          if (first?.merchants?.lat && first?.merchants?.lng) {
            setRegion((r) => ({ ...r, latitude: first.merchants!.lat, longitude: first.merchants!.lng }))
          }
        } else {
          setBaskets(data)
          const first = data[0]
          if ((first as any)?.merchants?.lat && (first as any)?.merchants?.lng) {
            setRegion((r) => ({ ...r, latitude: (first as any).merchants.lat, longitude: (first as any).merchants.lng }))
          }
        }
      } catch {
        const mocks = generateMockBaskets()
        setBaskets(mocks)
        const first = mocks[0]
        if (first?.merchants?.lat && first?.merchants?.lng) {
          setRegion((r) => ({ ...r, latitude: first.merchants!.lat, longitude: first.merchants!.lng }))
        }
      } finally {
        setLoading(false)
      }
    })()
  }, [])

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase()
    if (!q) return baskets
    return baskets.filter((b) => {
      const inTitle = b.title?.toLowerCase().includes(q)
      const inMerchant = b.merchants?.name?.toLowerCase().includes(q)
      const inCity = b.merchants?.city?.toLowerCase().includes(q)
      return inTitle || inMerchant || inCity
    })
  }, [query, baskets])

  const panResponder = useRef(
    PanResponder.create({
      onMoveShouldSetPanResponder: (_: GestureResponderEvent, gesture: PanResponderGestureState) => {
        return Math.abs(gesture.dx) > 12 && Math.abs(gesture.dy) < 10
      },
      onPanResponderRelease: (_: GestureResponderEvent, gesture: PanResponderGestureState) => {
        if (gesture.dx <= -50 && viewMode === 'list') {
          setViewMode('map')
        } else if (gesture.dx >= 50 && viewMode === 'map') {
          setViewMode('list')
        }
      },
    })
  ).current

  return (
    <View style={styles.container} {...panResponder.panHandlers}>
      <LinearGradient
        colors={[theme.colors.teal, theme.colors.tealDark]}
        style={styles.header}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
      >
        <View style={styles.navBar}>
          <Text style={styles.brand}>BQALI</Text>
          <Image
            source={require('../../assets/images/logo.png')}
            style={{ width: 82, height: 82, resizeMode: 'contain' }}
          />
          <View style={{ width: 48 }} />
        </View>

        <View style={styles.searchBar}>
          <TextInput
            placeholder="Rechercher un panier, établissement, ville"
            placeholderTextColor={"rgba(255,255,255,0.8)"}
            value={query}
            onChangeText={setQuery}
            style={styles.searchInput}
          />
        </View>

        <View style={styles.segment}>
          <Text
            onPress={() => setViewMode('list')}
            style={[styles.segmentItem, viewMode === 'list' && styles.segmentActive]}
          >
            Liste
          </Text>
          <Text
            onPress={() => setViewMode('map')}
            style={[styles.segmentItem, viewMode === 'map' && styles.segmentActive]}
          >
            Carte
          </Text>
        </View>
      </LinearGradient>

      {viewMode === 'list' ? (
        <FlatList
          contentContainerStyle={{ paddingBottom: 110, paddingTop: 12 }}
          data={filtered}
          keyExtractor={(item) => item.id}
          refreshing={loading}
          onRefresh={async () => {
            setLoading(true)
            try {
              const data = await api.getActiveBaskets()
              if (!data || data.length === 0) {
                setBaskets(generateMockBaskets())
              } else {
                setBaskets(data)
              }
            } catch {
              setBaskets(generateMockBaskets())
            } finally {
              setLoading(false)
            }
          }}
          renderItem={({ item }) => <BasketCard basket={item} />}
          ListEmptyComponent={!loading ? (
            <View style={styles.empty}>
              <Text style={styles.emptyText}>Aucun panier trouvé</Text>
            </View>
          ) : null}
        />
      ) : (
        <View style={styles.mapWrapper}>
          <MapViewComponent
            baskets={filtered}
            region={region as any}
            onRegionChangeComplete={setRegion as any}
            onMarkerPress={() => {}}
          />
          <View style={{ height: 90 }} />
        </View>
      )}

      <Button
        title="Mon compte"
        onPress={() => router.push('/(customer)/profile')}
      />

      <FooterBar />
    </View>
  )
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: theme.colors.background,
    paddingBottom: 0,
  },
  header: {
    paddingTop: 64,
    paddingBottom: 8,
    paddingHorizontal: theme.spacing.xl,
  },
  navBar: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    marginBottom: theme.spacing.lg,
  },
  brand: {
    color: theme.colors.white,
    fontSize: 28,
    fontWeight: '900',
    letterSpacing: 1,
  },
  searchBar: {
    backgroundColor: 'rgba(255,255,255,0.15)',
    borderRadius: theme.radius.lg,
    paddingHorizontal: 14,
    paddingVertical: 10,
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.25)'
  },
  searchInput: {
    color: theme.colors.white,
    fontSize: 16,
  },
  segment: {
    marginTop: 12,
    marginBottom: 8,
    flexDirection: 'row',
    gap: 8,
    alignSelf: 'center',
    backgroundColor: 'rgba(255,255,255,0.15)',
    borderRadius: theme.radius.pill,
    padding: 4,
  },
  segmentItem: {
    color: theme.colors.white,
    paddingHorizontal: 14,
    paddingVertical: 6,
    borderRadius: theme.radius.pill,
    fontWeight: '700',
  },
  segmentActive: {
    backgroundColor: theme.colors.white,
    color: theme.colors.tealDark,
  },
  empty: {
    padding: theme.spacing.xl,
    alignItems: 'center',
  },
  emptyText: {
    color: theme.colors.textMuted,
    fontWeight: '600',
  },
  mapWrapper: {
    flex: 1,
  },
})